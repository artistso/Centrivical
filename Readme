### 4.3 Core math: `app/src/main/java/org/centrivical/explorer/Centrivical.kt`

```kotlin
package org.centrivical.explorer

import kotlin.math.*

enum class Verdict { CENTRIVICAL, NOT_CENTRIVICAL, UNDETERMINED }

data class Interval(val lo: Double, val hi: Double) {
    init { require(lo <= hi) { "lo must be <= hi" } }
    fun containsValue(x: Double) = x in lo..hi
}

object Centrivical {
    /** Strict pointwise definition (A4): u_r < 0 and u_phi != 0. */
    fun isCentrivical(ur: Double, uphi: Double): Boolean = ur < 0.0 && uphi != 0.0

    /** Measurement classifier (Chapter 9). */
    fun classify(ir: Interval, iphi: Interval): Verdict = when {
        ir.hi < 0.0 && !iphi.containsValue(0.0) -> Verdict.CENTRIVICAL
        ir.lo >= 0.0 || (iphi.lo == 0.0 && iphi.hi == 0.0) -> Verdict.NOT_CENTRIVICAL
        else -> Verdict.UNDETERMINED
    }

    /** Signed transverse angle beta = atan2(u_phi, -u_r), defined only when centrivical. */
    fun beta(ur: Double, uphi: Double): Double? =
        if (isCentrivical(ur, uphi)) atan2(uphi, -ur) else null
}

/** Planar (radial-azimuthal) field. u_z is irrelevant to the predicate (L2). */
data class PlanarField(
    val name: String,
    val formula: String,
    val rMin: Double,                      // inner boundary of D (0 = axis only)
    val ur: (Double, Double) -> Double,    // (r, phi) -> u_r
    val uphi: (Double, Double) -> Double   // (r, phi) -> u_phi
)

val exampleNames = listOf("Linear spiral", "Sink + vortex", "Burgers-type", "Boundary approach")

fun makeField(which: Int, k: Double, s: Double): PlanarField = when (which) {
    0 -> PlanarField(exampleNames[0], "u_r = −k·r,   u_φ = s·r", 0.0,
        { r, _ -> -k * r }, { r, _ -> s * r })
    1 -> PlanarField(exampleNames[1], "u_r = −k/(2πr),   u_φ = s/(2πr)", 0.0,
        { r, _ -> -k / (2 * PI * r) }, { r, _ -> s / (2 * PI * r) })
    2 -> {
        val nu = 0.05 // core fixed with a = 1; exact Burgers vortex when k = 1
        PlanarField(exampleNames[2],
            "u_r = −(k/2)·r,   u_φ = s/(2πr)·(1 − e^(−r²/(4ν))),  ν = 0.05\n(exact Burgers vortex when k = 1)",
            0.0,
            { r, _ -> -(k / 2) * r },
            { r, _ -> s / (2 * PI * r) * (1 - exp(-r * r / (4 * nu))) })
    }
    else -> PlanarField(exampleNames[3], "u_r = −k·(r − 1),   u_φ = s,   on r > 1", 1.0,
        { r, _ -> -k * (r - 1) }, { _, _ -> s })
}

fun velocityXY(f: PlanarField, x: Double, y: Double): DoubleArray {
    val r = hypot(x, y)
    val phi = atan2(y, x)
    val ur = f.ur(r, phi)
    val up = f.uphi(r, phi)
    val c = cos(phi)
    val sn = sin(phi)
    return doubleArrayOf(ur * c - up * sn, ur * sn + up * c)
}

/** Streamline traced by RK4 in arc length (direction field u/|u|). */
fun streamline(
    f: PlanarField, x0: Double, y0: Double, rMax: Double,
    ds: Double = 0.01, maxSteps: Int = 3000
): List<Pair<Double, Double>> {
    val pts = ArrayList<Pair<Double, Double>>()
    var x = x0
    var y = y0
    fun dir(px: Double, py: Double): DoubleArray? {
        val v = velocityXY(f, px, py)
        val n = hypot(v[0], v[1])
        return if (!n.isFinite() || n < 1e-12) null else doubleArrayOf(v[0] / n, v[1] / n)
    }
    pts.add(x to y)
    repeat(maxSteps) {
        val r = hypot(x, y)
        if (r < f.rMin + 0.02 || r < 0.03 || r > rMax) return pts
        val k1 = dir(x, y) ?: return pts
        val k2 = dir(x + 0.5 * ds * k1[0], y + 0.5 * ds * k1[1]) ?: return pts
        val k3 = dir(x + 0.5 * ds * k2[0], y + 0.5 * ds * k2[1]) ?: return pts
        val k4 = dir(x + ds * k3[0], y + ds * k3[1]) ?: return pts
        x += ds / 6 * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0])
        y += ds / 6 * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1])
        pts.add(x to y)
    }
    return pts
}

/** Sampled check on an annulus. A numerical illustration, not a proof. */
fun centrivicalOnSampledAnnulus(f: PlanarField, rLo: Double, rHi: Double): Boolean =
    (0..40).all { i ->
        val r = rLo + (rHi - rLo) * i / 40.0
        (0 until 36).all { j ->
            val phi = 2 * PI * j / 36.0
            Centrivical.isCentrivical(f.ur(r, phi), f.uphi(r, phi))
        }
    }
```

### 4.4 User interface: `app/src/main/java/org/centrivical/explorer/MainActivity.kt`

```kotlin
package org.centrivical.explorer

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.foundation.Canvas
import androidx.compose.foundation.horizontalScroll
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.geometry.Offset
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.Path
import androidx.compose.ui.graphics.drawscope.Stroke
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import kotlin.math.*

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent { MaterialTheme { App() } }
    }
}

@Composable
fun App() {
    var tab by remember { mutableIntStateOf(0) }
    val titles = listOf("Define", "Classify", "Explore")
    Scaffold(bottomBar = {
        NavigationBar {
            titles.forEachIndexed { i, t ->
                NavigationBarItem(
                    selected = tab == i, onClick = { tab = i },
                    icon = { Text(t.take(1), fontWeight = FontWeight.Bold) },
                    label = { Text(t) })
            }
        }
    }) { pad ->
        Box(Modifier.padding(pad).fillMaxSize()) {
            when (tab) {
                0 -> DefineScreen()
                1 -> ClassifyScreen()
                else -> ExploreScreen()
            }
        }
    }
}

@Composable
fun DefineScreen() {
    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)) {
        Text("Centrivical", style = MaterialTheme.typography.headlineMedium)
        Text("Status: a PROPOSED term, not an established term in mathematics or physics.",
            fontWeight = FontWeight.Bold)
        Text("Definition. A field u is centrivical at a point x (off the axis A) iff\n\n" +
             "    u_r(x) < 0   and   u_φ(x) ≠ 0,\n\n" +
             "i.e. inward radial drift plus nonzero azimuthal velocity, relative to a stated axis and frame.")
        Text("• Not a force: no 'centrivical force', no force law.\n" +
             "• Not circulation: circulation is the loop integral ∮ u·dl.\n" +
             "• Not vorticity: centrivical fields may be irrotational or rotational.\n" +
             "• Frame-dependent: boosts and rotating frames can change the verdict.\n" +
             "• Inflow alone rules out periodic orbits; swirl makes the motion spiral.")
        Text("Etymology: a blend of centripetal + vortical ('center-seeking swirl').")
    }
}

@Composable
fun NumberField(label: String, value: String, onChange: (String) -> Unit, modifier: Modifier = Modifier) {
    OutlinedTextField(value = value, onValueChange = onChange, label = { Text(label) },
        singleLine = true, modifier = modifier)
}

@Composable
fun ClassifyScreen() {
    var ur by remember { mutableStateOf("-1.0") }
    var dR by remember { mutableStateOf("0.1") }
    var up by remember { mutableStateOf("0.5") }
    var dPhi by remember { mutableStateOf("0.1") }

    val a = ur.toDoubleOrNull()
    val da = dR.toDoubleOrNull()
    val b = up.toDoubleOrNull()
    val db = dPhi.toDoubleOrNull()
    val valid = a != null && da != null && b != null && db != null && da >= 0 && db >= 0

    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(10.dp)) {
        Text("Measurement classifier", style = MaterialTheme.typography.titleLarge)
        Text("Enter estimates with ± uncertainty (closed intervals).")
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            NumberField("u_r", ur, { ur = it }, Modifier.weight(1f))
            NumberField("± δr", dR, { dR = it }, Modifier.weight(1f))
        }
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
            NumberField("u_φ", up, { up = it }, Modifier.weight(1f))
            NumberField("± δφ", dPhi, { dPhi = it }, Modifier.weight(1f))
        }
        if (!valid) {
            Text("Enter numbers; uncertainties must be ≥ 0.", color = Color(0xFFC62828))
        } else {
            val verdict = Centrivical.classify(Interval(a!! - da!!, a + da), Interval(b!! - db!!, b + db))
            val (txt, col) = when (verdict) {
                Verdict.CENTRIVICAL -> "CENTRIVICAL (certified)" to Color(0xFF2E7D32)
                Verdict.NOT_CENTRIVICAL -> "NOT CENTRIVICAL (certified)" to Color(0xFFC62828)
                Verdict.UNDETERMINED -> "UNDETERMINED" to Color(0xFFEF6C00)
            }
            Text(txt, color = col, style = MaterialTheme.typography.headlineSmall)
            Text("I_r = [${fmt(a - da)}, ${fmt(a + da)}],   I_φ = [${fmt(b - db)}, ${fmt(b + db)}]")
            val beta = Centrivical.beta(a, b)
            Text(if (beta != null)
                "Central values: β = ${fmt(Math.toDegrees(beta))}°  (${if (beta > 0) "counterclockwise" else "clockwise"} viewed from +A)"
            else "Central values are not centrivical; β undefined.")
            Text("Rule: centrivical if sup I_r < 0 and 0 ∉ I_φ; not centrivical if I_r ⊂ [0,∞) or I_φ = {0}; " +
                 "otherwise undetermined. Unresolved swirl is not evidence of zero swirl.",
                style = MaterialTheme.typography.bodySmall)
        }
    }
}

fun fmt(x: Double) = String.format("%.3f", x)

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ExploreScreen() {
    var which by remember { mutableIntStateOf(0) }
    var k by remember { mutableFloatStateOf(1f) }
    var s by remember { mutableFloatStateOf(1f) }
    val rMax = 2.0

    val field = remember(which, k, s) { makeField(which, k.toDouble(), s.toDouble()) }
    val seeds = remember(field) {
        val rings = if (field.rMin > 0) listOf(1.9, 1.4) else listOf(1.9, 1.0)
        rings.flatMap { r0 -> (0 until 8).map { j -> val p = 2 * PI * j / 8; r0 * cos(p) to r0 * sin(p) } }
    }
    val lines = remember(field) { seeds.map { streamline(field, it.first, it.second, rMax) } }
    val rLo = field.rMin + 0.05
    val ok = remember(field) { centrivicalOnSampledAnnulus(field, rLo, rMax) }

    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(12.dp),
        verticalArrangement = Arrangement.spacedBy(6.dp)) {
        Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
            exampleNames.forEachIndexed { i, n ->
                FilterChip(selected = which == i, onClick = { which = i }, label = { Text(n) })
            }
        }
        Text(field.formula, style = MaterialTheme.typography.bodyMedium)
        Text("Inflow k = ${"%.1f".format(k)}")
        Slider(value = k, onValueChange = { k = it }, valueRange = -2f..2f, steps = 39)
        Text("Swirl s = ${"%.1f".format(s)}")
        Slider(value = s, onValueChange = { s = it }, valueRange = -2f..2f, steps = 39)
        Text(
            if (ok) "Sampled check on ${fmt(rLo)} ≤ r ≤ 2: centrivical at all 1476 sample points."
            else "Sampled check on ${fmt(rLo)} ≤ r ≤ 2: FAILS at some sample point (not centrivical).",
            color = if (ok) Color(0xFF2E7D32) else Color(0xFFC62828))
        Text("Sampling illustrates; it does not prove.", style = MaterialTheme.typography.bodySmall)

        Canvas(Modifier.fillMaxWidth().aspectRatio(1f)) {
            val scale = (size.minDimension / (2 * rMax)).toFloat()
            val c = Offset(size.width / 2, size.height / 2)
            fun toScreen(x: Double, y: Double) = Offset(c.x + (x * scale).toFloat(), c.y - (y * scale).toFloat())
            drawCircle(Color.LightGray, radius = (rMax * scale).toFloat(), center = c, style = Stroke(1.5f))
            if (field.rMin > 0) drawCircle(Color.Gray, radius = (field.rMin * scale).toFloat(), center = c, style = Stroke(3f))
            lines.forEach { pts ->
                if (pts.size > 1) {
                    val path = Path()
                    val p0 = toScreen(pts[0].first, pts[0].second)
                    path.moveTo(p0.x, p0.y)
                    for (i in 1 until pts.size) {
                        val p = toScreen(pts[i].first, pts[i].second)
                        path.lineTo(p.x, p.y)
                    }
                    drawPath(path, Color(0xFF1565C0), style = Stroke(3f))
                }
                drawCircle(Color(0xFF1565C0), radius = 5f, center = toScreen(pts[0].first, pts[0].second))
            }
            drawCircle(Color.Black, radius = 6f, center = c) // axis A, viewed from +A
        }
        Text("Black dot: axis A (viewed from its positive end). Dots: seed points. " +
             "Gray circle (Boundary approach): r = 1, which trajectories approach instead of the axis (L8c).",
            style = MaterialTheme.typography.bodySmall)
    }
}
```

### 4.5 Unit test: `app/src/test/java/org/centrivical/explorer/CentrivicalTest.kt`

```kotlin
package org.centrivical.explorer

import org.junit.Assert.*
import org.junit.Test

class CentrivicalTest {
    @Test fun strict() {
        assertTrue(Centrivical.isCentrivical(-1.0, 0.5))
        assertFalse(Centrivical.isCentrivical(0.0, 1.0))   // pure rotation
        assertFalse(Centrivical.isCentrivical(-1.0, 0.0))  // pure inflow
        assertFalse(Centrivical.isCentrivical(1.0, 1.0))   // outward spiral
    }
    @Test fun superpositionCounterexample() {               // L5
        assertFalse(Centrivical.isCentrivical(-1.0 + -1.0, 1.0 + -1.0))
    }
    @Test fun classifier() {
        assertEquals(Verdict.CENTRIVICAL, Centrivical.classify(Interval(-1.1, -0.9), Interval(0.4, 0.6)))
        assertEquals(Verdict.NOT_CENTRIVICAL, Centrivical.classify(Interval(0.0, 0.2), Interval(0.4, 0.6)))
        assertEquals(Verdict.NOT_CENTRIVICAL, Centrivical.classify(Interval(-1.0, -1.0), Interval(0.0, 0.0)))
        assertEquals(Verdict.UNDETERMINED, Centrivical.classify(Interval(-0.5, 0.1), Interval(0.9, 1.1))) // Exercise 6
    }
    @Test fun betaSign() {
        assertTrue(Centrivical.beta(-1.0, 1.0)!! > 0)
        assertTrue(Centrivical.beta(-1.0, -1.0)!! < 0)
        assertNull(Centrivical.beta(1.0, 1.0))
    }
}
```

---

## Part 5 — Building the APK and publishing the app

### 5.1 APK for direct distribution

| Goal | Android Studio | Command line |
|---|---|---|
| Debug APK (testing) | Build → Build APK(s) | `./gradlew assembleDebug` → `app/build/outputs/apk/debug/app-debug.apk` |
| Signed release APK | Build → Generate Signed Bundle/APK → APK | Configure signing, then `./gradlew assembleRelease` |
| Run tests | Run `CentrivicalTest` | `./gradlew test` |

**Back up your keystore and its passwords.** If you lose them, you cannot update an app you signed yourself.

A signed APK can be hosted on your website or on GitHub Releases. Users must allow installation from unknown sources.

### 5.2 Google Play Store

1. Create a **Play Console** developer account (one-time US$25 fee, plus identity verification).
2. Build an **Android App Bundle**: Build → Generate Signed Bundle/APK → Android App Bundle, or `./gradlew bundleRelease`. Play does not accept APKs for new apps.
3. Use **Play App Signing** (the default).
4. **Testing requirement:** new *personal* developer accounts must run a closed test with at least 12 opted-in testers for 14 continuous days before production access. Organization accounts are exempt. Check the current rules in Play Console, as Google revises them.
5. **Store listing:** short description, full description, at least two phone screenshots (Explore and Classify make good ones), a 512×512 icon and a 1024×500 feature graphic.
6. **Policy forms:**
   - Data safety: the app collects and shares no data.
   - Content rating questionnaire: Reference/Education, no objectionable content.
   - Target audience: adults or general.
   - Privacy policy URL: a one-paragraph page is enough, for example: *“Centrivical Explorer collects, stores, and transmits no personal or usage data. All computation happens on the device.”*
7. **Target API:** the app targets API 35, which current Play requirements for new apps call for. Raise it when Google raises the minimum.

**Suggested store description:**

> *Centrivical Explorer* accompanies the book *Centrivical: A Proposed Kinematic Term for Inward Swirling Flow*. “Centrivical” is a **proposed**, not established, term for flows with inward radial drift and nonzero azimuthal velocity. The app shows the definition, classifies measured velocity components (centrivical / not centrivical / undetermined) with the signed transverse angle β, and plots streamlines of canonical examples. Educational; no data collected.

